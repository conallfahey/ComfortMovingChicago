---
import QuotePlanner from "./QuotePlanner.astro";

const { editorial, quote, mainId, isArticle } = Astro.props;
const { title, subtitle, lead, byline, overlay, image, actions, quoteHeading, review, links, content, stats } = editorial;
const quoteHref = quote ? "#quoteForm" : "/#quoteForm";
const breadcrumb = isArticle ? { href: "/blog/", label: "Moving guides" } : { href: "/#areas-served", label: "Areas we serve" };
---
<main id={mainId} class="cmc-editorial-main cmc-service-main">
  <section class="cmc-editorial-hero">
    {overlay && <div class="hero-overlay-new" aria-hidden="true"></div>}
    <div class="cmc-editorial-width">
      <nav class="cmc-editorial-breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a><span aria-hidden="true">/</span><a href={breadcrumb.href}>{breadcrumb.label}</a>
      </nav>
      <div class:list={["cmc-editorial-grid", !quote && !image && "cmc-editorial-grid-single"]}>
        <div class="cmc-editorial-intro">
          <h1 set:html={title} />
          {subtitle && <p class="cmc-editorial-subtitle">{subtitle}</p>}
          {lead && <p class="cmc-editorial-lead" set:html={lead} />}
          {isArticle && !!byline.length && <ul class="cmc-editorial-byline">
            {byline.map(item => <li>{item}</li>)}
          </ul>}
          <div class="cmc-editorial-actions">
            {actions.length ? actions.map(({ href, label }) => (
              <a class:list={["cmc-button", href.startsWith("tel:") && "cmc-editorial-phone"]} href={href}>{label}</a>
            )) : <a class="cmc-button" href={quoteHref}>Get a moving quote</a>}
          </div>
          {!!stats?.length && <dl class="cmc-editorial-proof">
            {stats.map(([value, label]) => <div><dt>{label}</dt><dd>{value}</dd></div>)}
          </dl>}
        </div>
        {quote ? (
          <div class="cmc-editorial-quote" id="quoteForm">
            <h2>{quoteHeading}</h2>
            <QuotePlanner config={quote} />
          </div>
        ) : image && (
          <img class="cmc-editorial-image" src={image.src} alt={image.alt ?? ""}
            width={image.width} height={image.height} fetchpriority="high" />
        )}
      </div>
    </div>
  </section>
  {!!links.length && <nav class="cmc-editorial-contents cmc-editorial-width" aria-label="On this page">
    <ul>{links.map(({ id, label }) => <li><a href={`#${id}`}>{label}</a></li>)}</ul>
  </nav>}
  {isArticle
    ? <article class="cmc-editorial-article cmc-editorial-width" set:html={content} />
    : <Fragment set:html={content} />}
  {review && <section class="cmc-editorial-reviews">
    <div class="container" set:html={review} />
  </section>}
</main>
<Fragment set:html={editorial.scripts} />
